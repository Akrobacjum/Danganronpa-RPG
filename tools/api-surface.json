  "notes": {
    "config.ECLIPSE_FREE_PLACEMENT": {
      "value": [
        "night"
      ],
      "text": "The Eclipses that place freely, named by the time of day they lead into: the Night Eclipse, kept by the owner's decision D197 (01.11.2026). A stage that changes the list changes this note with the code."
    },
    "eclipseMovesLeft": {
      "nullAt": [
        "night"
      ],
      "text": "A number, or null while an Eclipse leading into a time of day of config.ECLIPSE_FREE_PLACEMENT runs (the darkening makes that null a 2). Always a number once ECLIPSE_FREE_PLACEMENT is empty."
    }
  }
