    "migrate1_2_0": {
      "target": "migrate",
      "since": "E52",
      "keepUntil": "1.3.1",
      "note": "The data migration's name from the 1.2.0 update (S01-56); the same function. Deprecated: call migrate()."
    },
    "advanceFloorNow": {
      "target": "skipStep",
      "since": "E70",
      "keepUntil": null,
      "note": "An older name kept by E70: Skip without the trial's check."
    },
    "extendFloor": {
      "target": "adjustTime",
      "since": "E70",
      "keepUntil": null,
      "note": "An older name kept by E70: extendFloor(seconds) adds the seconds, signed as at 1.2.89; no number is +30 s."
    },
    "endFloor": {
      "target": "endMode",
      "since": "E70",
      "keepUntil": null,
      "note": "An older name kept by E70: closes the floor whatever runs."
    },
    "exportLedger": {
      "target": "backupCase",
      "since": "E04",
      "keepUntil": null,
      "note": "The Truth Bullet ledger's backup until E04; the same function."
    },
    "importLedger": {
      "target": "restoreCase",
      "since": "E04",
      "keepUntil": null,
      "note": "The Truth Bullet ledger's restore until E04; the same function, which takes the old files too."
    },
    "isSilenced": {
      "target": "isCrimeSilenced",
      "since": "E33",
      "keepUntil": null,
      "note": "The crime-witness reader's name until E33 C9; the same function."
    },
    "musicDialog": {
      "target": "soundDialog",
      "since": "1.1.8",
      "keepUntil": null,
      "note": "The Sound window's name while it was only about music; the same function."
    },
    "currentRoom": {
      "target": "roomOfActor",
      "since": "0.2.2",
      "keepUntil": null,
      "note": "The same function, under both names since the first upload (action-rolls.mjs re-exports movement.mjs roomOfActor as currentRoom)."
    }
