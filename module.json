{
  "id": "danganronpa-rpg",
  "title": "Danganronpa RPG",
  "description": "Turns the Daggerheart system (Foundryborne) into the Danganronpa RPG System: renamed traits, Despair instead of Fear, forced private rolls, a time-of-day action economy, per-room search tokens, Remnants on the map and Truth Bullets in the inventory.",
  "version": "1.1.22",
  "compatibility": {
    "minimum": "14.364",
    "verified": "14.365"
  },
  "authors": [
    {
      "name": "Akrobacjum"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "daggerheart",
        "type": "system",
        "compatibility": {
          "minimum": "2.6.0",
          "verified": "2.6.5"
        }
      }
    ],
    "requires": [
      {
        "id": "dice-so-nice",
        "type": "module",
        "manifest": "https://gitlab.com/riccisi/foundryvtt-dice-so-nice/-/raw/master/module/module.json",
        "reason": "Every roll in this game is thrown in front of the table. Dice So Nice is how they are seen."
      },
      {
        "id": "isometric-perspective",
        "type": "module",
        "manifest": "https://github.com/arlosmolten/isometric-perspective/releases/latest/download/module.json",
        "reason": "The academy maps are drawn isometric. Without it the scenes, tokens and Remnants are laid out on a grid the art was never made for."
      },
      {
        "id": "avclient-livekit",
        "type": "module",
        "manifest": "https://github.com/bekriebel/fvtt-module-avclient-livekit/releases/latest/download/module.json",
        "reason": "Per-room voice: regions become LiveKit breakout rooms, and moving between rooms moves who can hear you."
      }
    ]
  },
  "esmodules": [
    "scripts/module.mjs"
  ],
  "styles": [
    "styles/motion.css",
    "styles/danganronpa.css",
    "styles/messenger.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "socket": true,
  "url": "https://github.com/Akrobacjum/Danganronpa-RPG",
  "manifest": "https://github.com/Akrobacjum/Danganronpa-RPG/releases/latest/download/module.json",
  "download": "https://github.com/Akrobacjum/Danganronpa-RPG/releases/latest/download/module.zip"
}
