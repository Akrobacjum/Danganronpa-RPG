{
  "id": "danganronpa-rpg",
  "title": "Danganronpa RPG",
  "description": "Turns the Daggerheart system (Foundryborne) into the Danganronpa RPG System: renamed traits, Despair instead of Fear, forced private rolls, a time-of-day action economy, per-room search tokens, Remnants on the map and Truth Bullets in the inventory. In English and Polish (Polski).",
  "version": "1.2.96",
  "compatibility": {
    "minimum": "14.364",
    "verified": "14.365"
  },
  "authors": [
    {
      "name": "Akrobacjum"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "daggerheart",
        "type": "system",
        "compatibility": {
          "minimum": "2.6.5",
          "verified": "2.6.5"
        }
      }
    ],
    "requires": [
      {
        "id": "dice-so-nice",
        "type": "module",
        "manifest": "https://gitlab.com/riccisi/foundryvtt-dice-so-nice/-/raw/master/module/module.json",
        "reason": "Every roll is thrown as 3D dice, seen only by the people allowed to see that roll, in the one dice style the GM sets for the table."
      },
      {
        "id": "isometric-perspective",
        "type": "module",
        "manifest": "https://github.com/arlosmolten/isometric-perspective/releases/latest/download/module.json",
        "reason": "Maps drawn for isometric play will look wrong on a flat grid."
      },
      {
        "id": "avclient-livekit",
        "type": "module",
        "manifest": "https://github.com/bekriebel/fvtt-module-avclient-livekit/releases/latest/download/module.json",
        "reason": "Voice follows the rooms: you hear the people in the room your character is in, and moving to another room changes who hears you."
      }
    ]
  },
  "esmodules": [
    "scripts/module.mjs"
  ],
  "styles": [
    "styles/motion.css",
    "styles/danganronpa.css",
    "styles/stained-glass.css",
    "styles/pixel-icons.css",
    "styles/messenger.css",
    "styles/narrow.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "socket": true,
  "url": "https://github.com/Akrobacjum/Danganronpa-RPG",
  "manifest": "https://github.com/Akrobacjum/Danganronpa-RPG/releases/latest/download/module.json",
  "download": "https://github.com/Akrobacjum/Danganronpa-RPG/releases/latest/download/module.zip"
}
