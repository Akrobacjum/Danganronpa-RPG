# Keep repository-only files out of module.zip (built with `git archive`).
# docs/img holds README media - screenshots and GIFs - which players never need
# at runtime and which would triple the size of the package; docs/design and
# the old changelog are working papers.
# docs/handbooks SHIPS (1.2.55): the book button in the corner opens them.
docs/img/ export-ignore
docs/design/ export-ignore
docs/changelog-1.2.0.md export-ignore
.gitattributes export-ignore
.gitignore export-ignore

# How the project is worked on, not how it is played: useful in the repository,
# nothing a module installed in a Data folder has any use for.
CLAUDE.md export-ignore
CONTRIBUTING.md export-ignore

# tools/ is the same: the generators for the icons and the Polish config check.
# Nothing at runtime imports them, and they shipped in the 1.2.47 and 1.2.48 zips (88 KB).
tools/ export-ignore

# audit/ is the v1.1.88 review: the headless harness and its report. Useful in
# the repository, pointless inside a module people install.
audit/ export-ignore

# Repository plumbing, not module content.
.github/ export-ignore
