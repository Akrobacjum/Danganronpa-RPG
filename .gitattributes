# Keep repository-only files out of module.zip (built with `git archive`).
# docs/ holds README media - screenshots and GIFs - which players never need
# at runtime and which would triple the size of the package.
docs/ export-ignore
.gitattributes export-ignore
.gitignore export-ignore

# How the project is worked on, not how it is played: useful in the repository,
# nothing a module installed in a Data folder has any use for.
CLAUDE.md export-ignore
CONTRIBUTING.md export-ignore

# audit/ is the v1.1.88 review: the headless harness and its report. Useful in
# the repository, pointless inside a module people install.
audit/ export-ignore

# Repository plumbing, not module content.
.github/ export-ignore
